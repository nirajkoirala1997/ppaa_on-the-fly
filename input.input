# One card for lo_sa, kp_sa, virt_sa and rs_sa. Seed, cuts, histograms and
# physics values are shared; only each program's [stats_*] block differs.
#
# p p -> gamma gamma, MATRIX ppaa02 setup: 13.6 TeV, muR = muF = m(gamma gamma).
# The NLO set below is for the NLO pieces; compare LO with NNPDF30_lo_as_0118.

[run]
seed      = 1001
resume    = no

[stats_lo]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_kp]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_virt]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_rs]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[output]
dir       = ../summary/run_02_high_mass

[beam]
ecm       = 13600.0

[pdf]
set        = NNPDF30_nlo_as_0118
member     = 0
variations = no

[scales]
dynamic   = yes
mur_fixed = 91.1876
muf_fixed = 91.1876

# MATRIX ppaa02 model.dat.
[masses]
mZ        = 91.1876
wZ        = 2.4952
mW        = 80.385
wW        = 2.0854
mH        = 125.0
wH        = 0.00407
mtop      = 173.2
wtop      = 1.44262

# MATRIX ppaa02 model.dat: G_mu scheme with complex masses.
[ew]
gfermi    = 1.16639e-5
aewm1     = 128.0

[constants]
pi        = 3.141592653589793238462643
hbarc2    = 0.3893793721e12

[psgen]
sqsc      = 1.0e-8

[olp]
provider       = recola
real_generator = recola

# Provisional defaults: to be compared with DYN's kinvar3 in the rs_sa step.
[subtraction]
del_s     = 1.0e-6
del_c     = 1.0e-6

[virtual]
terms     = virt_iop

# MATRIX ppaa02 acceptance. pta_min and maa_min must be > 0.
[cuts]
pta_min   = 20.0
etaa_max  = 2.47
maa_min   = 500.0

# Frixione, mode 1 = epsilon form, as MATRIX frixione_isolation = 1.
[isolation]
mode      = 1
n         = 1.0
epsilon   = 0.5
et_max    = 5.0
delta_0   = 0.4
m_hard    = 91.1876

# Legs 3 and 4 are the photons. High-mass run: every MATRIX m_gamgam edge from
# 500 to 2000 GeV is a multiple of 10, so its wider bins are sums of these.
[histograms]
maa     obs = mass    legs = 3,4   nbins = 150   xmin = 500.0   xmax = 2000.0
