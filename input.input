# One card for lo_sa, kp_sa, virt_sa and rs_sa. Seed, cuts, histograms and
# physics values are shared; only each program's [stats_*] block differs.
#
# 13.6 TeV, one PDF set for all four programs: 10 GeV bins
# centred on Q = 180..220, muR = muF = m(ee).

[run]
seed      = 1001
resume    = no

[stats_lo]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_kp]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_virt]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[stats_rs]
n_adapt   = 100000
it_adapt  = 10
n_prod    = 1000000
it_prod   = 20
epsrel    = 0.0

[output]
dir       = ../summary/run_01

[beam]
ecm       = 13600.0

[pdf]
set        = MMHT2014nlo68cl
member     = 0
variations = no

[scales]
dynamic   = yes
mur_fixed = 91.1876
muf_fixed = 91.1876

# DYN's committed constants_mod.f90. The Z and W widths are physical here:
# the Z is resonant in the Drell-Yan amplitude.
[masses]
mZ        = 91.1876
wZ        = 2.4952
mW        = 80.3850115091
wW        = 2.0854
mH        = 125.10
wH        = 0.0
mtop      = 172.57
wtop      = 0.0

# DYN's LO value. DYN's real piece used 1.16639e-5, a 1e-5 relative difference.
[ew]
gfermi    = 1.16638e-5
aewm1     = 128.0

[constants]
pi        = 3.141592653589793238462643
hbarc2    = 0.3893793721e12

[psgen]
sqsc      = 1.0e-8

[olp]
provider       = recola
real_generator = recola

# Provisional defaults: to be compared with DYN's kinvar3 in the rs_sa step.
[subtraction]
del_s     = 1.0e-6
del_c     = 1.0e-6

[virtual]
terms     = virt_iop

# Window covering only the five validation bins. mee_min must be > 0.
[cuts]
mee_min   = 175.0
mee_max   = 225.0

# Kept for later photon studies; no integrand applies it yet.
[isolation]
mode      = 1
n         = 1.0
epsilon   = 0.5
et_max    = 5.0
delta_0   = 0.4
m_hard    = 91.1876

# Legs: 3 = e+, 4 = e-. One q q~ amplitude serves both beam orderings, so only
# observables even in cos(theta*) are exact: no single-lepton eta or y, no dr.
[histograms]
mee     obs = mass    legs = 3,4   nbins = 5     xmin = 175.0  xmax = 225.0
ptep    obs = pt      leg  = 3     nbins = 40    xmin = 0.0    xmax = 200.0
ptem    obs = pt      leg  = 4     nbins = 40    xmin = 0.0    xmax = 200.0
ptll    obs = pt      legs = 3,4   nbins = 40    xmin = 0.0    xmax = 100.0
yll     obs = y       legs = 3,4   nbins = 30    xmin = -4.0   xmax = 4.0
