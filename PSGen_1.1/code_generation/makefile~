#---------------------------------------------------------------
#FF = ifort
#FFLAGS = -traceback -check bounds
#---------------------------------------------------------------
FF = gfortran
FFLAGS = -fcheck=bounds
#---------------------------------------------------------------
OBJECTS =  psgen_info.o proc_name.o read_process.o \
           PSGen.o genps.o wrkinprms.o wrt72.o 

.f.o: ; $(FF) $(FFLAGS) -c $*.f 

a.out: $(OBJECTS)  $(EIGEN) makefile
	$(FF) -o a.out $(FFLAGS) $(OBJECTS) 
PSGen.o: PSGen.f psgen_info.f proc_name.f
	$(FF) $(FFLAGS) -c PSGen.f 
read_process.o: read_process.f psgen_info.f
	$(FF) $(FFLAGS) -c read_process.f 
genps.o: genps.f psgen_info.f
	$(FF) $(FFLAGS) -c genps.f 
wrkinprms.o: wrkinprms.f psgen_info.f 
	$(FF) $(FFLAGS) -c wrkinprms.f 
.PHONY: code

code: a.out
	time ./a.out > test
	mv fourmom.f ../../carlomat_4.5/mc_computation/
	mv engymom.f ../../carlomat_4.5/mc_computation/
	mv kincls.f ../../carlomat_4.5/mc_computation/
	mv kinschnl.f ../../carlomat_4.5/mc_computation/
	mv tchcalls.f ../../carlomat_4.5/mc_computation/
	mv kingchnl.f ../../carlomat_4.5/mc_computation/
	mv kinparams.f ../../carlomat_4.5/mc_computation/
	mv process_nm.dat ../../carlomat_4.5/mc_computation/
	mv nkin_decl.f ../../carlomat_4.5/mc_computation/
	rm -f schcalls.txt
	rm -f schcalls2.txt
	rm -f gchcalls.txt
	rm -f gchcalls2.txt
	less test
