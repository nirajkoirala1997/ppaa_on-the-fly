      subroutine wrkinprms(nfsp)

      use psgen_info

      integer :: nfsp
      character(80) :: ind
      character(160) :: cm

      open(unit=20,file='kinparams.f',status='replace',action='write')
      open(unit=18,file='nkin_decl.f',status='replace',action='write')

      write(20,'(a)')'      module kinparams'
      write(20,'(a)') ' '
      write(20,'(a)')'      use inprms_ps'
      write(20,'(a)') ' '
      if (iquadp == 1) then
       write(20,'(a)')'      integer, parameter :: iqprec=1'
       write(20,'(a)')'      integer, parameter :: xp=kind(1.q0)'
      else
       write(20,'(a)')'      integer, parameter :: iqprec=0'
       write(20,'(a)')'      integer, parameter :: xp=kind(1.d0)'
      end if
      write(ind,'(i4)') nptcl
      write(20,'(a)') '      integer, parameter :: nexp='//
     &                                            trim(adjustl(ind))   
      write(ind,'(i4)') nfsp
      write(20,'(a)') '      integer, parameter :: nfsp='//
     &                                            trim(adjustl(ind))   
      write(ind,'(i4)') nkins2
      write(18,'(a)') '      integer, parameter :: nkins='//
     &                                            trim(adjustl(ind))   
      write(ind,'(i4)') nkins2+nkint2
      write(18,'(a)') '      integer, parameter :: nkinst='//
     &                                            trim(adjustl(ind))   
      write(ind,'(i4)') nkins2+nkint2+nking2
      write(18,'(a)') '      integer, parameter :: nkinag='//
     &                                            trim(adjustl(ind))   
      write(18,'(a)') '      integer, parameter :: nkin='//
     &                                            trim(adjustl(ind))   
      write(ind,'(i4)') ipsgen
      write(18,'(a)') '      integer, parameter :: ipsgen='//
     &                                            trim(adjustl(ind))   
      close(18)
      write(20,'(a)') '      include ''nkin_decl.f'''
      write(ind,'(i4)') igind2
      write(20,'(a)') '      integer, parameter :: igind='//
     &                                            trim(adjustl(ind))   
      write(20,'(a)') '      real(xp) :: m(nexp)'
      write(20,'(a)') '      character(10) :: expc(nexp)'
      write(20,'(a)') '      character(1) :: expl(nexp)'
      write(20,'(a)') ' '
      write(20,'(a)') '      integer :: iwkin(nkin)'
c      write(20,'(a)') '      real(kind(1.d0)) :: aw(nkin), xmc(0:nkin)'
      write(20,'(a)') '      real(kind(1.d0)) :: aw(nkin)' ! 8 March, 2024
      write(20,'(a)') '      real(kind(1.d0)) :: aw_w(nkin,3)'
      write(20,'(a)') ' '
      write(20,'(a)') '      contains'
      write(20,'(a)') '       subroutine exp_masses'

      cm='       m=(/'                        ! 22 Feb. 2023 >

      do i=1,nptcl
       if (i < nptcl) then
        if(iquadp == 1) then
         cm=trim(cm)//trim(cmass(i))//'_qp,'
        else
         cm=trim(cm)//trim(cmass(i))//','
        end if
       else
        if(iquadp == 1) then
         cm=trim(cm)//trim(cmass(i))//'_qp/)'
        else
         cm=trim(cm)//trim(cmass(i))//'/)'
        end if
       end if
      end do
      call wrt72(20,cm)                      ! 22 Feb. 2023 <
      write(20,'(a)') '       end subroutine exp_masses'
      write(20,'(a)') '       subroutine exp_names'
      do i=1,nptcl
       write(ind,'(i4)') i
       write(20,'(a)') '        expc('//trim(adjustl(ind))//')='
     &                 //''''//trim(ptcl(i))//''''
       write(20,'(a)') '        expl('//trim(adjustl(ind))//')='
     &                 //''''//trim(ptclt(i))//''''
      end do
      write(20,'(a)') '       end subroutine exp_names'
      write(20,'(a)') ' '
      write(20,'(a)')'      end module kinparams'

      close(20)

      end


